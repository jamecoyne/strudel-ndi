{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Strudel REPL window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "fs:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive"
  ]
}
